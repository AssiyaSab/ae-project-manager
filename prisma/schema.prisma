// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int               @id @default(autoincrement())
  name             String
  phone            String?           @unique
  telegramId       String?           @unique
  role             String            // "ADMIN" | "MANAGER" | "ACCOUNTANT" | "ENGINEER" | "ASSEMBLER" | "WAREHOUSE" | "SUPPLY"
  title            String?           // Job title / designation
  isActive         Boolean           @default(true) // Status of employee (active or archived)
  login            String?           @unique
  password         String?
  pinCode          String?           // Персональный 4-значный ПИН-код для подтверждения крупных операций (>500k ₸)
  tasks            Task[]
  managedProjects  Project[]         @relation("ProjectManager")
  purchaseRequests PurchaseRequest[] @relation("Requester")
  supplyRequests   PurchaseRequest[] @relation("SupplyAssigned")
  receivedRequests PurchaseRequest[] @relation("ReceivedBy")
  businessTrips    BusinessTrip[]
  heldTools        Tool[]
  toolLogs         ToolLog[]
  auditLogs        AuditLog[]
  createdSaleOrders SaleOrder[]       @relation("SaleOrderCreatedBy")
  shippedSaleOrders SaleOrder[]       @relation("SaleOrderShippedBy")
}

model Project {
  id               Int               @id @default(autoincrement())
  name             String
  description      String?
  status           String            // "DESIGN" | "PURCHASE" | "ASSEMBLY" | "COMMISSIONING" | "DONE"
  budget           Float?            // Общий бюджет проекта
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tasks            Task[]
  managerId        Int?
  manager          User?             @relation("ProjectManager", fields: [managerId], references: [id])
  purchaseRequests PurchaseRequest[]
  businessTrips    BusinessTrip[]
  toolLogs         ToolLog[]
}

model Task {
  id          Int      @id @default(autoincrement())
  projectId   Int
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String   // "PENDING" | "IN_PROGRESS" | "OTK" | "BLOCKED" | "DONE"
  cost        Float?   // Фактические затраты на эту конкретную задачу
  assignees   User[]
  alerts      Alert[]
  updatedAt   DateTime @updatedAt
}

model Alert {
  id        Int      @id @default(autoincrement())
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  status    String   // "ACTIVE" | "RESOLVED"
  createdAt DateTime @default(now())
}

// --- НОВЫЕ МОДЕЛИ ---

model PurchaseRequest {
  id                  Int       @id @default(autoincrement())
  type                String    @default("INVOICE") // "INVOICE" (Безналичный счет) | "EXPENSE" (Срочный подотчет/чек)
  title               String
  amount              Float     @default(0) // Итоговая сумма по счету или чеку
  projectId           Int
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileUrl             String?   // Ссылка на скан/чек инженера (или спецификацию)
  status              String    @default("PENDING_APPROVAL") // PENDING_APPROVAL | IN_PROCUREMENT | PENDING_PAYMENT_APPROVAL | APPROVED_FOR_PAYMENT | PAID_AND_ORDERED | DELIVERED | REJECTED (а также старые PENDING, APPROVED, PAID для совместимости)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  // Данные заявителя
  requesterId         Int?
  requester           User?     @relation("Requester", fields: [requesterId], references: [id])
  
  // Данные обработки снабжением
  supplierName        String?   // Поставщик (ТОО / ИП)
  invoiceNumber       String?   // Номер счета
  invoiceDate         DateTime? // Дата счета
  plannedDeliveryDate DateTime? // Срок / дата поставки
  supplyComment       String?   // Комментарий / условия доставки
  invoiceFileUrl      String?   // Ссылка / скан счета на оплату от поставщика
  supplyUserId        Int?
  supplyUser          User?     @relation("SupplyAssigned", fields: [supplyUserId], references: [id])
  
  // Данные оплаты и приемки
  paymentReceiptUrl   String?   // Платежка бухгалтера
  paidAt              DateTime?
  deliveredAt         DateTime?
  receivedByUserId    Int?
  receivedByUser      User?     @relation("ReceivedBy", fields: [receivedByUserId], references: [id])
}

model BusinessTrip {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  destination String
  purpose     String
  startDate   DateTime
  endDate     DateTime
  budget      Float    // Плановый бюджет (суточные + проезд + проживание)
  projectId   Int?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status      String   @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "COMPLETED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tool {
  id           Int       @id @default(autoincrement())
  name         String
  serialNumber String?
  category     String    // "Электроинструмент", "Измерительные приборы", "Ручной инструмент"
  status       String    @default("AVAILABLE") // "AVAILABLE" | "PENDING_ACCEPTANCE" | "IN_USE" | "REPAIR" | "WRITTEN_OFF"
  isArchived   Boolean   @default(false)
  holderId     Int?
  holder       User?     @relation(fields: [holderId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  logs         ToolLog[]
}

model ToolLog {
  id                Int       @id @default(autoincrement())
  toolId            Int
  tool              Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  employeeId        Int
  employee          User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId         Int?
  project           Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  issueDate         DateTime  @default(now())
  plannedReturnDate DateTime?
  actualReturnDate  DateTime?
  condition         String?   // Состояние при возврате
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  createdAt DateTime @default(now())
}

// --- МОДУЛЬ ПРОДАЖ ОБОРУДОВАНИЯ (ONKA / WEG) ---

model SaleOrder {
  id                     Int             @id @default(autoincrement())
  orderNumber            String          @unique // Например: "СЧ-2026-001"
  customerName           String          // Наименование покупателя (ТОО / ИП / Физ.лицо)
  customerBin            String?         // БИН / ИИН покупателя
  customerPhone          String?         // Контактный телефон
  customerEmail          String?         // Email для отправки счета
  customerAddress        String?         // Юридический / фактический адрес
  brand                  String?         @default("ONKA") // "ONKA" | "WEG" | "MIXED"
  status                 String          @default("DRAFT") // "DRAFT" | "INVOICE_SENT" | "PAID" | "READY_FOR_PICKUP" | "SHIPPED"
  totalAmount            Float           @default(0) // Итоговая сумма (KZT)
  vatRate                Float           @default(12) // Ставка НДС (%)
  vatAmount              Float           @default(0) // Сумма НДС (KZT)
  invoiceDate            DateTime        @default(now()) // Дата выставления счета
  paidAt                 DateTime?       // Дата фиксации оплаты
  shippedAt              DateTime?       // Дата фактической отгрузки со склада
  notes                  String?         // Примечания к сделке

  // Обязательные поля доверенности покупателя при отгрузке
  powerOfAttorneyNumber  String?         // Номер доверенности (например, "№ 12-Д")
  powerOfAttorneyDate    DateTime?       // Дата выдачи доверенности
  issuedToName           String?         // ФИО доверенного лица, принимающего товар
  powerOfAttorneyFileUrl String?         // Скан / фото оригинала доверенности

  // Пользователи
  createdById            Int?
  createdBy              User?           @relation("SaleOrderCreatedBy", fields: [createdById], references: [id])
  warehouseUserId        Int?
  warehouseUser          User?           @relation("SaleOrderShippedBy", fields: [warehouseUserId], references: [id])

  items                  SaleOrderItem[]

  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

model SaleOrderItem {
  id          Int       @id @default(autoincrement())
  orderId     Int
  order       SaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  brand       String    @default("ONKA") // "ONKA" | "WEG" | "ДРУГОЕ"
  article     String    // Артикул / каталожный номер
  name        String    // Наименование оборудования/позиции
  unit        String    @default("шт") // Единица измерения
  quantity    Float     @default(1)    // Количество
  price       Float     @default(0)    // Цена за единицу с НДС (KZT)
  total       Float     @default(0)    // Итоговая сумма строки (quantity * price)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}


